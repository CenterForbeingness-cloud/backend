# Copy this file to .env and fill in values
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Required in production for the chosen AI_PROVIDER (Phase 1 item 5).
AI_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
CHAT_MODEL_SCHEDULE=gpt-4o-mini
SCHEDULE_HISTORY_MESSAGES=6
# guide = themes, RAG, profile (default). script = verbatim Say:"..." beats.
SCHEDULE_MODE=guide
RAG_ENABLED=true
SCHEDULE_SCRIPT_ENGINE=true
PORT=8000

# Optional path to the proprietary Ben master system prompt (gitignored).
# Default file: prompts/ben_master_system_prompt_v1.txt
# Fallback: prompts/ben_master_system_prompt_stub.txt
# Production requires the real v1 prompt or env (Phase 1 item 7). Stub is not enough.
# BEN_MASTER_PROMPT_PATH=
# BEN_MASTER_SYSTEM_PROMPT=

# Supabase
SUPABASE_URL=
# Use service-role key only for backend NEVER expose in frontend
SUPABASE_KEY=
SUPABASE_DB_URL=
# Required and must connect in production (Phase 1 item 4).
# Production also refuses in-memory chat and filesystem course catalog fallbacks (Phase 4).
# Optional in local development (in-memory chat and filesystem catalog allowed).
SUPABASE_JWT_SECRET=

# Auth / security Track A production (see documentation Track A launch checklist)
# Local: ENVIRONMENT=development and the three flags below false
# Railway production: ENVIRONMENT=production (or RAILWAY_ENVIRONMENT=production)
#   and AUTH_ENFORCED=true, CHAT_TOKEN_ENFORCED=true, RATE_LIMIT_ENABLED=true
#   Production will refuse to start if any of those three are off.
ENVIRONMENT=development
AUTH_ENFORCED=false
# Comma-separated allowed origins (empty = allow all in development; required in production)
CORS_ORIGINS=
CHAT_TOKEN_ENFORCED=false
# Optional override; defaults to SUPABASE_JWT_SECRET when empty.
CHAT_TOKEN_SECRET=
# 900 = 15 minutes
CHAT_TOKEN_TTL_SECONDS=900

# IP rate limiting (must be true in production)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_SESSIONS=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_BILLING=15/minute

# RAG
RAG_ENABLED=false
RAG_TOP_K=3

# Voice (MVP Launch) — POST /chat/voice
VOICE_ENABLED=false
VOICE_MAX_RECORDING_SEC=90
VOICE_DAILY_SECONDS_CAP=600
WHISPER_MODEL=whisper-1
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_DEFAULT=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# RAG / Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=sentient-content
EMBEDDING_MODEL=text-embedding-3-small

# Admin console (optional — comma-separated; empty = allow all IPs in dev)
ADMIN_ALLOWED_IPS=
ADMIN_2FA_ISSUER=Sentient
ADMIN_UI_URL=https://backend-production-2df9.up.railway.app/admin/ui
# Resend HTTP API — all transactional email from this backend
# (admin invites/password reset + app signup/recovery via Supabase Send Email Hook)
# Waitlist email still runs on the marketing site (separate Resend usage).
# 1. Verify your domain in Resend (or use onboarding@resend.dev for testing only)
# 2. Create API key (re_...) at https://resend.com/api-keys
# 3. Set Railway/production variables below
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Sentient <noreply@yourdomain.com>
# Alias still accepted: ADMIN_INVITE_FROM_EMAIL=
#
# Supabase Dashboard → Authentication → Hooks → Send Email Hook
# URL: https://<your-api-host>/hooks/supabase/send-email
# Paste the hook secret here (format: v1,whsec_...)
SUPABASE_SEND_EMAIL_HOOK_SECRET=

# Website waitlist (same Supabase project as marketing site)
# Optional: shared secret for POST /public/marketing/page-view (Sentaint Web beacon)
MARKETING_BEACON_SECRET=
RATE_LIMIT_MARKETING=120/minute

# Billing (Stripe)
# Production requires PAYMENT_STAGE=test or live (Phase 1 item 6).
PAYMENT_STAGE=
STRIPE_SECRET_KEY= 
STRIPE_PUBLISHABLE_KEY=
# Backward-compatible alias if older code still references this key name.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-course Price IDs — required for checkout until course_products is seeded in Supabase
STRIPE_PRICE_STARTER_BUNDLE=
STRIPE_PRICE_WEEK_ZERO_RESET=
STRIPE_PRICE_DEEP_CALM=
STRIPE_PRICE_FOCUS_DISCIPLINE=
